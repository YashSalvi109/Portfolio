# Copy to .env.local for `vercel dev`, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.

# API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Inbox that receives contact-form messages
CONTACT_EMAIL=yashssalvi@outlook.com

# Optional: sender address. Must be on a domain verified in Resend.
# Defaults to Resend's test sender (onboarding@resend.dev), which can only
# deliver to the email address of the Resend account owner.
# CONTACT_FROM="Yash Salvi Portfolio <contact@your-domain.com>"
